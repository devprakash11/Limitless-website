# Application
NODE_ENV=development
PORT=5000

# Comma-separated frontend origins. Do not add a trailing slash.
CLIENT_ORIGINS=http://localhost:5173,http://localhost:3000

# Gmail SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=help.limitlessdesign@gmail.com
SMTP_PASS=PASTE_YOUR_16_CHARACTER_GOOGLE_APP_PASSWORD_HERE

# Email identity
SMTP_FROM_NAME=Limitless Design Website
SMTP_FROM_EMAIL=help.limitlessdesign@gmail.com
ADMIN_EMAIL=help.limitlessdesign@gmail.com

# Set to true to send an automatic confirmation email to the visitor.
SEND_CUSTOMER_CONFIRMATION=true
