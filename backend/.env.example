NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=https://your-frontend.vercel.app

# Required: Supabase database connection
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Optional: contact form email notifications
GMAIL_USER=your-email@example.com
GMAIL_APP_PASSWORD=YOUR_GMAIL_APP_PASSWORD

# Optional: Cloudinary — required only when file upload routes are used
CLOUDINARY_CLOUD_NAME=YOUR_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_API_KEY
CLOUDINARY_API_SECRET=YOUR_API_SECRET
CLOUDINARY_FOLDER=limitless
MAX_UPLOAD_MB=10
