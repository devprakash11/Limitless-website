NODE_ENV=development
PORT=5000

# Comma-separated frontend origins. Do not add trailing slashes.
FRONTEND_URLS=http://localhost:5173,https://your-frontend-domain.com

# Supabase -> Connect -> Session pooler connection string.
DATABASE_URL=postgresql://postgres.PROJECT_REF:DATABASE_PASSWORD@HOST:5432/postgres
DATABASE_SSL=true

JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=8h
IP_HASH_SALT=replace-with-another-long-random-secret

# SMTP email notification settings.
# Gmail example: smtp.gmail.com, port 465, secure true.
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=help.limitlessdesign@gmail.com
SMTP_PASS=qjlz fqka tuhb ugnt
SMTP_FROM_NAME=Limitless Design
SMTP_FROM_EMAIL=help.limitlessdesign@gmail.com
CONTACT_TO_EMAIL=help.limitlessdesign@gmail.com

TURNSTILE_REQUIRED=false
TURNSTILE_SECRET_KEY=
